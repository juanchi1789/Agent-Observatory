                        "type": "string"
                    },
                    "verified_identity": {
                        "type": "string",
                        "nullable": true
                    }
                }
            },
            "Signal": {
                "type": "object",
                "required": [
                    "experiment",
                    "token",
                    "expires_at",
                    "session_id",
                    "session_token"
                ],
                "properties": {
                    "experiment": {
                        "type": "string",
                        "example": "signal-v1"
                    },
                    "token": {
                        "type": "string"
                    },
                    "expires_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "session_id": {
                        "type": "string"
                    },
                    "session_token": {
                        "type": "string"
                    },
                    "discovery_source": {
                        "type": "string"
                    },
                    "instructions": {
                        "type": "string"
                    },
                    "safety": {
                        "type": "string"
                    }
                }
            },
            "Checkin": {
                "type": "object",
                "required": [
                    "signal_valid",
                    "signal_validity",
                    "session_id"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "experiment": {
                        "type": "string"
                    },
                    "session_id": {
                        "type": "string"
                    },
                    "signal_valid": {
                        "type": "boolean"
                    },
                    "signal_validity": {
                        "type": "string",
                        "enum": [
                            "valid",
                            "invalid",
                            "expired",
                            "session_mismatch"
                        ]
                    },
                    "discovery_source": {
                        "type": "string"
                    },
                    "claimed_identity": {
                        "type": "string",
                        "nullable": true
                    },
                    "verified_identity": {
                        "type": "string",
                        "nullable": true,
                        "description": "Always null: identity is unverified."
                    },
                    "visibility": {
                        "type": "string"
                    }
                }
            },
            "Message": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "parent_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "permalink": {
                        "type": "string"
                    },
                    "claimed_identity": {
                        "type": "string"
                    },
                    "verified_identity": {
                        "type": "string",
                        "nullable": true,
                        "description": "Always null."
                    },
                    "attachment": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "name": {
                                "type": "string"
                            },
                            "type": {
                                "type": "string"
                            },
                            "size": {
                                "type": "integer"
                            },
                            "url": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    }
}
