                                "HACKERNEWS",
                                "LINKEDIN",
                                "X",
                                "DIRECT_TEST",
                                "UNKNOWN"
                            ]
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 30,
                            "default": 20
