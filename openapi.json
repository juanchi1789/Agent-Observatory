        "/api/checkin": {
            "post": {
                "operationId": "checkIn",
                "summary": "Complete a voluntary signal check-in (private owner log)",
                "description": "JSON and normal HTML forms share the same handler and validations. Body limit 2500 bytes; identity/message plain text without URLs or HTML. 10 attempts/source/hour, 1000/site/day. 201 means recorded: require signal_valid=true. Token replay returns 409. Cookie-free clients can recover the signal session using the token. Form responses are safe HTML.",
                "parameters": [
                    {
                        "name": "X-Observatory-Session",
                        "in": "header",
                        "required": false,
                        "description": "Preserve the returned session_token or cookies across requests. Telemetry only, never authentication.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "src",
                        "in": "query",
                        "required": false,
                        "description": "First session attribution wins. Use DIRECT_TEST for tests. Legacy discovery surface values remain supported; no source or identity is verified.",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "WEB",
                                "LLMSTXT",
                                "AGENTJSON",
                                "SITEMAP",
                                "ORGANIC",
                                "GITHUB",
                                "REDDIT",
                                "HACKERNEWS",
                                "LINKEDIN",
                                "X",
                                "DIRECT_TEST",
                                "UNKNOWN"
                            ]
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "token"
                                ],
                                "properties": {
                                    "token": {
                                        "type": "string",
                                        "maxLength": 1500
                                    },
                                    "claimed_identity": {
                                        "type": "string",
                                        "maxLength": 80,
                                        "nullable": true
                                    },
                                    "message": {
                                        "type": "string",
                                        "maxLength": 300,
                                        "nullable": true
                                    }
                                }
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "token"
                                ],
                                "properties": {
                                    "token": {
                                        "type": "string",
                                        "maxLength": 1500
                                    },
                                    "claimed_identity": {
                                        "type": "string",
                                        "maxLength": 80,
                                        "nullable": true
                                    },
                                    "message": {
                                        "type": "string",
                                        "maxLength": 300,
                                        "nullable": true
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Recorded; check signal_valid. Invalid/expired/mismatched signals are recorded with false.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Checkin"
                                }
                            },
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Request rejected; inspect error. Limits return Retry-After.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Request rejected; inspect error. Limits return Retry-After.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Request rejected; inspect error. Limits return Retry-After.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Already completed signal.",
                        "content": {
